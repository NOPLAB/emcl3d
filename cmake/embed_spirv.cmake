if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT)
  message(FATAL_ERROR "embed_spirv.cmake requires INPUT and OUTPUT")
endif()
file(READ "${INPUT}" bytes HEX)
string(LENGTH "${bytes}" length)
math(EXPR remainder "${length} % 8")
if(length EQUAL 0 OR NOT remainder EQUAL 0)
  message(FATAL_ERROR "SPIR-V input must contain complete 32-bit words")
endif()
set(words "")
math(EXPR last "${length} - 8")
foreach(offset RANGE 0 ${last} 8)
  string(SUBSTRING "${bytes}" ${offset} 8 word)
  string(REGEX REPLACE "^(..)(..)(..)(..)$" "0x\\4\\3\\2\\1u," word "${word}")
  string(APPEND words "  ${word}\n")
endforeach()
file(WRITE "${OUTPUT}" "#pragma once\n#include <cstdint>\nnamespace emcl3d::detail {\ninline constexpr uint32_t map_distance_spirv[] = {\n${words}};\n}\n")
